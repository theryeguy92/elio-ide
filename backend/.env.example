# ── Storage ────────────────────────────────────────────────────────────────
# Pick one, or leave both blank to use local SQLite (backend/local.db).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── GPU rental ─────────────────────────────────────────────────────────────
# Optional. Leave blank to run in local mode (all GPU endpoints return a
# "local mode" response instead of calling RunPod).
RUNPOD_API_KEY=

# ── LLM provider ────────────────────────────────────────────────────────────
# Used by the Assistant panel and AI commit messages. Two options:
#
# 1. Anthropic (default when ANTHROPIC_API_KEY is set):
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
#
# 2. Any OpenAI-compatible endpoint — Kimi, ZAI GLM, OpenRouter, vLLM, Ollama:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.moonshot.ai/v1      # Kimi
# LLM_BASE_URL=https://api.z.ai/api/paas/v4    # ZAI GLM
# LLM_BASE_URL=http://localhost:11434/v1       # Ollama (local, no key needed)
# LLM_API_KEY=
# LLM_MODEL=kimi-k2-0905-preview

# ── Git integration ─────────────────────────────────────────────────────────
# Path to the project git repository. Defaults to current directory.
GIT_REPO_PATH=/home/rlevey/Projects/personal/elio-ide

# ── Obsidian vault ──────────────────────────────────────────────────────────
# Path to your Obsidian vault for the Vault sidebar panel.
VAULT_PATH=/home/rlevey/vaults/RegMetAI
